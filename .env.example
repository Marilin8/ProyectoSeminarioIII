SECRET_KEY=django-insecure-cambia-esta-clave-en-produccion
DEBUG=True

DB_NAME=clinica_imagenes_main
DB_USER=root
DB_PASSWORD=admin12345
DB_HOST=127.0.0.1
DB_PORT=3306

# Envío de resultados por correo (SMTP Gmail).
# EMAIL_HOST_PASSWORD debe ser una "contraseña de aplicación" de Google
# (16 caracteres, SIN espacios), no la contraseña normal de la cuenta.
# Requiere tener activada la verificación en 2 pasos.
# Si se dejan vacíos, el sistema no manda correos (avisa y no rompe).
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Verificación de que el correo ingresado (paciente/usuario) existe de
# verdad, vía la Email Verification API de AbstractAPI (capa gratis:
# https://www.abstractapi.com/api/email-verification-validation-api).
# Si se deja vacío, esa verificación simplemente no corre (no bloquea nada).
ABSTRACT_API_KEY=
